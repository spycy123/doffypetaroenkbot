# ==========================================
# KONFIGURASI TELEGRAM BOT & LLM TUTOR
# ==========================================

# 1. Telegram Bot Token (dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=

# 2. Pilihan LLM Provider: gemini | openai | groq
LLM_PROVIDER=gemini

# 3. Konfigurasi Google Gemini (wajib jika LLM_PROVIDER=gemini)
# Dapatkan API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=
# Nama model Gemini (contoh: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# 4. Konfigurasi OpenAI (wajib jika LLM_PROVIDER=openai)
# Dapatkan API Key di: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Nama model OpenAI (contoh: gpt-4o-mini atau gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# 5. Konfigurasi Groq (wajib jika LLM_PROVIDER=groq)
# Dapatkan API Key gratis di: https://console.groq.com/keys
GROQ_API_KEY=
# Model open-source terbaru & ter-update (sangat cerdas & respon cuma 0.3 detik)
GROQ_MODEL=qwen/qwen3.8-27b

# 6. Keamanan & Batasan Penggunaan
# Daftar Telegram User ID yang diizinkan (dipisah koma). Kosongkan jika bot boleh diakses oleh publik.
ALLOWED_USER_IDS=

# Jumlah riwayat pesan sebelumnya yang disimpan & dikirim ke LLM (default: 20)
MAX_HISTORY_MESSAGES=20

# Maksimal pesan yang dikirim user per menit untuk mencegah spam (default: 10)
RATE_LIMIT_PER_MINUTE=10

# 6. Mode Bot (polling untuk development lokal, webhook untuk production/VPS)
MODE=polling

# Port HTTP server (digunakan saat MODE=webhook, default: 3000)
PORT=3000

# Pengaturan Webhook (wajib jika MODE=webhook)
WEBHOOK_URL=
WEBHOOK_SECRET=
